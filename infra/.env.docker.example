# Docker Compose environment variables
# Copy this to .env.docker for docker-compose deployments
# The .env.docker file is ignored by git and should never be committed

# Backend / Spring Boot (uses docker service name 'postgres')
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/projecthub
SPRING_DATASOURCE_USERNAME=db_user
SPRING_DATASOURCE_PASSWORD=db_password
APP_JWT_SECRET=your-secret-key-here
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose - PostgreSQL
POSTGRES_DB=projecthub

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
