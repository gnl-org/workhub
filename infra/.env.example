# Docker Compose environment variables
# Copy this to .env, .env.dev, or .env.prod
# Never commit any .env file

# Backend / Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/projecthub
SPRING_DATASOURCE_URL_AUTH=jdbc:postgresql://<host>:5432/projecthub_auth
SPRING_DATASOURCE_URL_NOTIFICATIONS=jdbc:postgresql://<host>:5432/projecthub_notifications
SPRING_DATASOURCE_USERNAME=db_user
SPRING_DATASOURCE_PASSWORD=db_password
APP_JWT_SECRET=your-secret-key-here
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL databases
POSTGRES_DB=projecthub
POSTGRES_DB_AUTH=projecthub_auth
POSTGRES_DB_NOTIFICATIONS=projecthub_notifications

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
